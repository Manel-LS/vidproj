# Secrets — never commit
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Runtime data (uploads, renders, sqlite db, temp work dirs)
backend/var/
backend/.env
# ...and any copy of it. A backup made before a config change is still config.
backend/.env.*
.env.*.bak

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
frontend/next-env.d.ts
*.tsbuildinfo

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Vidéos exportées (livrables, pas du code source)
exports/
