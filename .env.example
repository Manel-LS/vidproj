# ============================================================================
# Reelcraft — environment template
#
# Copy to `.env` and edit. `.env` is git-ignored; never commit real secrets.
# Every value here is optional in development: with an empty file the app runs
# on SQLite, local storage, the in-process job queue and the built-in planner.
# ============================================================================

# ---------------------------------------------------------------- General ---
ENVIRONMENT=development          # development | test | production
DEBUG=true
APP_NAME=Reelcraft
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------------------------- Security ---
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=60

# --------------------------------------------------------------- Database ---
# Leave empty in development to use a local SQLite file (backend/var/reelcraft.db).
# REQUIRED in production. PostgreSQL and MySQL/MariaDB are both supported:
#
#   PostgreSQL      DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/reelcraft
#   MySQL / MariaDB DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/reelcraft
#   XAMPP / WAMP    DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/reelcraft
#
# A bare `mysql://` is rewritten to use PyMySQL (no C toolchain needed on Windows)
# and `charset=utf8mb4` is appended automatically — MySQL's `utf8` is three bytes
# and would silently strip the emoji in captions and hashtags.
#
# Create the database first, then run `alembic upgrade head`:
#   CREATE DATABASE reelcraft CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=

# ---------------------------------------------------------------- Storage ---
STORAGE_PROVIDER=local           # local | s3
# Where the browser fetches stored files from. The relative default resolves against
# whichever host the API is reached on, so there is no hostname to keep in sync and it
# works unchanged behind a reverse proxy. Set an absolute URL only when files are
# served from a different origin (a CDN, for example).
STORAGE_PUBLIC_BASE_URL=/api/v1/files
# STORAGE_LOCAL_ROOT=/var/lib/reelcraft/storage

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO). Needs `pip install boto3`.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------- Uploads ---
MAX_IMAGE_BYTES=15728640         # 15 MB
MAX_AUDIO_BYTES=26214400         # 25 MB
MAX_IMAGES_PER_PROJECT=40
IMAGE_MAX_DIMENSION=2560

# -------------------------------------------------------------- Rendering ---
# Leave FFMPEG_BINARY empty to auto-resolve: PATH first, then the ffmpeg bundled
# with the `imageio-ffmpeg` package (which is why local dev needs no install).
FFMPEG_BINARY=
FFPROBE_BINARY=
RENDER_FPS=30
RENDER_SUPERSAMPLE=2.0           # 1.0 is fastest, 2.0 gives smooth Ken Burns motion
RENDER_CRF=20                    # lower = better quality, bigger file
RENDER_PRESET=medium             # ultrafast … veryslow
RENDER_THREADS=0                 # 0 lets ffmpeg decide
RENDER_TIMEOUT_SECONDS=900
# Point at your own brand typeface to use it for every text overlay:
RENDER_FONT_PATH=

# ------------------------------------------------------------------- Jobs ---
JOB_QUEUE=thread                 # thread (in-process) | celery (Redis, production)
REDIS_URL=redis://localhost:6379/0
THREAD_QUEUE_WORKERS=2

# ------------------------------------------------------- AI video planner ---
# With no key set, the deterministic built-in planner is used and the UI says so.
LLM_PROVIDER=auto                # auto | anthropic | openai_compatible | heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Any OpenAI-compatible endpoint (OpenAI, Azure, Together, Ollama, vLLM…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------ AI voice-over (TTS) ---
# Leave as `none` to disable voice-over; the UI shows it as unavailable.
#
#   edge        Microsoft Edge neural voices — free, no API key, 300+ voices
#               including Arabic (ar-TN-HediNeural, ar-TN-ReemNeural for Tunisian).
#               It uses Edge's "read aloud" endpoint, which is not a documented
#               public API: it may change without notice and its terms say nothing
#               explicit about commercial use. Excellent for building and for
#               unbudgeted work; use a contracted provider for a paid product.
#   elevenlabs  Best quality, paid, needs ELEVENLABS_API_KEY.
#   openai      Paid, needs OPENAI_API_KEY.
TTS_PROVIDER=none                # none | edge | elevenlabs | openai

# `edge` only. Empty => the voice is chosen from the script's writing system,
# so an Arabic script is not read out by a French voice.
EDGE_TTS_VOICE=
EDGE_TTS_RATE=-8%                # a narration reads better slightly slower
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ------------------------------------------------- AI Motion (image→video) ---
# Leave as `none` to disable AI Motion mode. Standard mode always works.
# ---- lip sync (silent clip + voice -> speaking clip) ------------------------
LIPSYNC_PROVIDER=none            # none | synclabs | heygen | replicate
SYNCLABS_API_KEY=
SYNCLABS_MODEL=lipsync-2
HEYGEN_API_KEY=
REPLICATE_LIPSYNC_MODEL=sync/lipsync-2
LIPSYNC_POLL_INTERVAL_SECONDS=5
LIPSYNC_TIMEOUT_SECONDS=900
# Sync Labs and HeyGen download the media themselves, so they need STORAGE_PROVIDER=s3
# (or a public base URL). Replicate accepts uploads and works with local storage.

# ---- image generation (text -> still image) --------------------------------
IMAGE_PROVIDER=none              # none | openai | replicate | google
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001
IMAGE_TIMEOUT_SECONDS=180

I2V_PROVIDER=none                # none | runway | kling | luma
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
LUMA_API_KEY=
I2V_POLL_INTERVAL_SECONDS=5
I2V_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------- Seed ---
SEED_DEMO_USER_EMAIL=demo@reelcraft.app
SEED_DEMO_USER_PASSWORD=demo1234

# --------------------------------------------------------------- Frontend ---
# Read by Next.js at build time; must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
